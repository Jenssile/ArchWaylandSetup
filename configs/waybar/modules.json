{
  "custom/tmux": {
    "exec": "~/.config/waybar/scripts/tmux_sessions.sh",
    "interval": 10,
    "return-type": "json",
    "format": "{}",
    "env": {
      "TMUX_MAX_SESSIONS": "5"
    }
  },
  // Power Menu
  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout -b 4",
    "tooltip": false
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu_status.sh 30 60",  // <low max> <medium max>
    "interval": 5,
    "format": " {}",
    "return-type": "json",
    "on-click": "alacritty -e btop"
  },

  "custom/mem": {
    "exec": "~/.config/waybar/scripts/mem_status.sh 30 60",
    "interval": 5,
    "format": " {}",
    "return-type": "json",
    "on-click": "alacritty -e btop"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu_status.sh 30 60",
    "interval": 5,
    "format": " {}",
    "return-type": "json",
    "on-click": "alacritty -e radeontop"
  },

  "custom/menu": {
    "format": "☰",
    "on-click": "~/.config/waybar/scripts/toggle-popup.sh",
    "tooltip": false
  }
}
