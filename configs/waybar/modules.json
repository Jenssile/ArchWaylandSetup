{
  "custom/tmux": {
    "exec": "~/.config/waybar/scripts/tmux_sessions.sh",
    "interval": 10,
    "return-type": "json",
    "format": "{}",
    "env": {
      "TMUX_MAX_SESSIONS": "5"
    }
  },
  // Power Menu
  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout -b 4",
    "tooltip": false
  },
}
